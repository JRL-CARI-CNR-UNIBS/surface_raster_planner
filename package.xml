<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>surface_raster_planner</name>
  <version>0.1.0</version>
  <description>Generates a raster (serpentine) tool path over a reconstructed surface mesh, by PCA and ray casting. Developed by CARI-JRL.</description>
  <maintainer email="manuel.beschi@unibs.it">Manuel Beschi (CARI-JRL)</maintainer>
  <author email="manuel.beschi@unibs.it">Manuel Beschi</author>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>shape_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>visualization_msgs</depend>
  <depend>surface_raster_planner_msgs</depend>
  <depend>tf2_eigen</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>
  <depend>libvtk9-dev</depend>

  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
